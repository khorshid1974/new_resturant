@page "/cashier"
@using RestaurantApp.Data.Models
@using RestaurantApp.Data.Services
@inject IOrderService OrderService
@inject ILogger<Cashier> Logger
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Cashier")]
@layout CashierLayout

<link href="css/cashier.css" rel="stylesheet" />

<div class="container mt-4 cashier-container">
    <h2 class="cashier-header">Cashier Dashboard</h2>

    @if (orders == null)
    {
        <div class="loading-state">
            <p><i class="bi bi-hourglass-split"></i> Loading orders...</p>
        </div>
    }
    else if (!orders.Any())
    {
        <div class="empty-state">
            <i class="bi bi-receipt" style="font-size: 2rem;"></i>
            <h4 class="mt-3">No Unpaid Orders</h4>
            <p>All orders have been processed and paid.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in orders)
            {
                <div class="col-md-6 mb-4">
                    <div class="card accounting-card">
                        <div class="card-header accounting-card-header">
                            <h5 class="table-name">Table @order.Table.Name</h5>
                            <small class="order-time">@order.OrderTime.ToString("HH:mm")</small>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(order.SpecialInstructions))
                            {
                                <div class="special-instructions mb-3">
                                    <strong>Special Instructions:</strong>
                                    <p class="mb-0">@order.SpecialInstructions</p>
                                </div>
                            }

                            <div class="table-responsive mb-3">
                                <table class="table table-sm accounting-table">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th class="text-end">Qty</th>
                                            <th class="text-end">Price</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <tr>
                                                <td>
                                                    @item.MenuItem.Name
                                                    @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions))
                                                    {
                                                        <br>
                                                        <small class="text-muted">@item.SpecialInstructions</small>
                                                    }
                                                </td>
                                                <td class="text-end">@item.Quantity</td>
                                                <td class="text-end amount">$@item.UnitPrice.ToString("F2")</td>
                                                <td class="text-end amount">$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                            <td class="text-end total-amount">$@order.TotalAmount.ToString("F2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="d-flex justify-content-between">
                                <button class="btn accounting-btn print-btn" @onclick="() => PrintBill(order)">
                                    <i class="bi bi-printer"></i> Print Bill
                                </button>
                                <button class="btn accounting-btn paid-btn" @onclick="() => MarkAsPaid(order)">
                                    <i class="bi bi-cash"></i> Mark as Paid
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Order> orders = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize cashier.js animations
            JS.InvokeVoidAsync("import", "/js/cashier.js");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try
        {
            orders = (await OrderService.GetUnpaidOrdersAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading unpaid orders");
        }
    }

    private async Task MarkAsPaid(Order order)
    {
        try
        {
            await OrderService.UpdateOrderStatusAsync(order.Id, OrderStatus.Completed);
            orders.Remove(order);
            Logger.LogInformation($"Order {order.Id} marked as paid");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Error marking order {order.Id} as paid");
        }
    }

    private async Task PrintBill(Order order)
    {
        // Create a print-friendly version of the bill
        await JS.InvokeVoidAsync("openPrintWindow", new
        {
            table = order.Table.Name,
            time = order.OrderTime.ToString("HH:mm"),
            items = order.OrderItems.Select(oi => new
            {
                name = oi.MenuItem.Name,
                quantity = oi.Quantity,
                price = oi.UnitPrice,
                subtotal = oi.Quantity * oi.UnitPrice
            }),
            total = order.TotalAmount,
            specialInstructions = order.SpecialInstructions
        });
    }
}