@page "/admin/dashboard"
@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]

<div class="dashboard-container">
    <h1>Admin Dashboard</h1>
    <p>Welcome, Admin! Use the sidebar to manage the menu or view reports.</p>
    
    <div class="dashboard-cards">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Menu Items</h5>
                <p class="card-text">Manage your restaurant's menu items</p>
                <a href="/admin/menu" class="btn btn-primary">Go to Menu Manager</a>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
        margin-top: 2rem;
    }

    .card {
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-title {
        margin-bottom: 1rem;
        color: #2c3e50;
    }

    .card-text {
        color: #6c757d;
        margin-bottom: 1.5rem;
    }
</style> 